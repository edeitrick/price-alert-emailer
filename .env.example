# Copy to .env.local (never commit it). Used by web/ (Next.js) and checker/.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Checker only (secret — server side / GitHub Actions secrets, never in the extension or browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Until you verify a domain in Resend, keep the default sender; it can only email your own address.
EMAIL_FROM=Price Alert Emailer <onboarding@resend.dev>
WEB_APP_URL=http://localhost:3000
