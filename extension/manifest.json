{
  "manifest_version": 3,
  "name": "Price Alert Emailer",
  "version": "0.4.0",
  "description": "Save products and get an email when the price drops — at this store or others you shop.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Price Alert Emailer" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://www.amazon.com/*",
    "https://www.sephora.com/*",
    "https://www.ulta.com/*",
    "https://www.target.com/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://price-alert-emailer.vercel.app/*"]
  }
}
